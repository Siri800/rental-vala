# ==========================================
# RENTAL VALA - ENVIRONMENT CONFIGURATION
# ==========================================

NODE_ENV=development
APP_NAME="Rental Vala"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# Database (PostgreSQL)
DATABASE_URL="postgresql://rentalvala:rentalvala_secret@localhost:5432/rentalvala_db?schema=public"

# Redis (Cache, OTP, BullMQ Queues)
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_ACCESS_SECRET="replace_with_64_char_random_hex_string_access"
JWT_REFRESH_SECRET="replace_with_64_char_random_hex_string_refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_DOMAIN="localhost"
OTP_SECRET_SALT="replace_with_32_char_random_salt"

# Object Storage (S3 / Cloudflare R2 / Local MinIO)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin123"
S3_BUCKET_PUBLIC="rental-vala-public"
S3_BUCKET_PRIVATE="rental-vala-kyc-private"
S3_PUBLIC_CDN_URL="http://localhost:9000/rental-vala-public"
S3_BUCKET_MEDIA="rental-vala-media"
S3_MEDIA_PUBLIC_URL="http://localhost:9000/rental-vala-media"

# Payment Gateway (Razorpay Test/Live)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"

# Email Service (SMTP / Resend)
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_USER="resend"
SMTP_PASS="re_placeholder_api_key"
EMAIL_FROM="noreply@rentalvala.in"

# SMS / OTP Gateway (Twilio / MSG91)
SMS_PROVIDER="console" # "console" for dev, "msg91" or "twilio" for prod
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# Frontend Public Variables
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder"
