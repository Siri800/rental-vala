NODE_ENV=development
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_PORT=8085

# Local PostgreSQL and Redis
DATABASE_URL="postgresql://user:password@localhost:5432/rentalvala_db?schema=public"
REDIS_URL="redis://localhost:6379"

# Authentication
JWT_ACCESS_SECRET="replace_with_a_random_access_secret"
JWT_REFRESH_SECRET="replace_with_a_random_refresh_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
OTP_SECRET_SALT="replace_with_a_random_otp_salt"
ADMIN_LOGIN_KEY=""

# Object storage (optional for local development)
MINIO_ENDPOINT="http://localhost:9000"
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_MEDIA="rental-vala-media"
S3_MEDIA_PUBLIC_URL=""

# Configure either Resend or SMTP for email verification.
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Rental Vala <noreply@rentalvala.in>"

# Razorpay Standard Checkout
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
