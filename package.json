{
  "name": "rental-vala",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @rental-vala/database prisma generate",
    "db:migrate": "pnpm --filter @rental-vala/database prisma migrate dev",
    "db:deploy": "pnpm --filter @rental-vala/database prisma migrate deploy",
    "db:seed": "pnpm --filter @rental-vala/database prisma db seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  }
}